NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=
# Set to "true" only in the deployed/online environment to block Explora,
# login and registro while still showing the rest of the site. Leave unset
# (or "false") locally so those keep working during development.
NEXT_PUBLIC_LAUNCH_LOCKED=false
# Public site URL used for sitemap/robots and absolute metadata URLs.
NEXT_PUBLIC_SITE_URL=https://workcofy.com
# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when
# calling app/api/cron/* routes. Generate any random string and set the same
# value in Vercel's project environment variables.
CRON_SECRET=
# Not read by app code — record of the hola@workcofy.com mailbox (Hostinger
# Business Email) used as Supabase Auth's custom SMTP sender. The actual
# config lives in Supabase's dashboard (Project Settings -> Authentication ->
# SMTP Settings), not here.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_NAME=Workcofy
# NVIDIA NIM (build.nvidia.com) API key — free-tier, OpenAI-compatible chat
# completions. Powers the daily cron's tips generator (lib/tips/generateTips.ts);
# left unset, that step silently no-ops instead of failing the cron.
NVIDIA_API_KEY=
